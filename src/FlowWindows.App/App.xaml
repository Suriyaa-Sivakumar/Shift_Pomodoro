<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="FlowWindows_App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FlowWindows_App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Base / Direct Application Brushes -->
            <SolidColorBrush x:Key="ShiftFlowGreenBrush" Color="#2DB88F" />
            <SolidColorBrush x:Key="ShiftFlowGreenMutedBrush" Color="#1F3D34" />
            <SolidColorBrush x:Key="ShiftCardBgBrush" Color="#1E2023" />
            <SolidColorBrush x:Key="ShiftSubtleBgBrush" Color="#1AFFFFFF" />
            <SolidColorBrush x:Key="ShiftTrackBrush" Color="#2A2D32" />
            <SolidColorBrush x:Key="ShiftTextPrimaryBrush" Color="#F5F5F7" />
            <SolidColorBrush x:Key="ShiftTextSecondaryBrush" Color="#8E8E93" />

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="ShiftFlowGreenBrush" Color="#2DB88F" />
                    <SolidColorBrush x:Key="ShiftFlowGreenMutedBrush" Color="#1F3D34" />
                    <SolidColorBrush x:Key="ShiftCardBgBrush" Color="#1E2023" />
                    <SolidColorBrush x:Key="ShiftSubtleBgBrush" Color="#1AFFFFFF" />
                    <SolidColorBrush x:Key="ShiftTrackBrush" Color="#2A2D32" />
                    <SolidColorBrush x:Key="ShiftTextPrimaryBrush" Color="#F5F5F7" />
                    <SolidColorBrush x:Key="ShiftTextSecondaryBrush" Color="#8E8E93" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="ShiftFlowGreenBrush" Color="#1E5E4E" />
                    <SolidColorBrush x:Key="ShiftFlowGreenMutedBrush" Color="#E5EFEA" />
                    <SolidColorBrush x:Key="ShiftCardBgBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="ShiftSubtleBgBrush" Color="#0A000000" />
                    <SolidColorBrush x:Key="ShiftTrackBrush" Color="#EAEAEA" />
                    <SolidColorBrush x:Key="ShiftTextPrimaryBrush" Color="#1C1C1E" />
                    <SolidColorBrush x:Key="ShiftTextSecondaryBrush" Color="#6E6E73" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="ShiftFlowGreenBrush" Color="#2DB88F" />
                    <SolidColorBrush x:Key="ShiftFlowGreenMutedBrush" Color="#1F3D34" />
                    <SolidColorBrush x:Key="ShiftCardBgBrush" Color="#1E2023" />
                    <SolidColorBrush x:Key="ShiftSubtleBgBrush" Color="#1AFFFFFF" />
                    <SolidColorBrush x:Key="ShiftTrackBrush" Color="#2A2D32" />
                    <SolidColorBrush x:Key="ShiftTextPrimaryBrush" Color="#F5F5F7" />
                    <SolidColorBrush x:Key="ShiftTextSecondaryBrush" Color="#8E8E93" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
