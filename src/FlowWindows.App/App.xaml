<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="FlowWindows_App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FlowWindows_App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Base / Direct Application Brushes -->
            <SolidColorBrush x:Key="ShiftFlowGreenBrush" Color="#2DB88F" />
            <SolidColorBrush x:Key="ShiftFlowGreenMutedBrush" Color="#1F3D34" />
            <SolidColorBrush x:Key="ShiftCardBgBrush" Color="#1E2023" />
            <SolidColorBrush x:Key="ShiftSubtleBgBrush" Color="#22FFFFFF" />
            <SolidColorBrush x:Key="ShiftTrackBrush" Color="#2A2D32" />
            <SolidColorBrush x:Key="ShiftTextPrimaryBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ShiftTextSecondaryBrush" Color="#CBD5E1" />
            <SolidColorBrush x:Key="ShiftTextMutedBrush" Color="#94A3B8" />

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="ShiftFlowGreenBrush" Color="#2DB88F" />
                    <SolidColorBrush x:Key="ShiftFlowGreenMutedBrush" Color="#1F3D34" />
                    <SolidColorBrush x:Key="ShiftCardBgBrush" Color="#1E2023" />
                    <SolidColorBrush x:Key="ShiftSubtleBgBrush" Color="#22FFFFFF" />
                    <SolidColorBrush x:Key="ShiftTrackBrush" Color="#2A2D32" />
                    <SolidColorBrush x:Key="ShiftTextPrimaryBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="ShiftTextSecondaryBrush" Color="#CBD5E1" />
                    <SolidColorBrush x:Key="ShiftTextMutedBrush" Color="#94A3B8" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="ShiftFlowGreenBrush" Color="#10B981" />
                    <SolidColorBrush x:Key="ShiftFlowGreenMutedBrush" Color="#E6F7F2" />
                    <SolidColorBrush x:Key="ShiftCardBgBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="ShiftSubtleBgBrush" Color="#0D000000" />
                    <SolidColorBrush x:Key="ShiftTrackBrush" Color="#E5E7EB" />
                    <SolidColorBrush x:Key="ShiftTextPrimaryBrush" Color="#0F172A" />
                    <SolidColorBrush x:Key="ShiftTextSecondaryBrush" Color="#475569" />
                    <SolidColorBrush x:Key="ShiftTextMutedBrush" Color="#64748B" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="ShiftFlowGreenBrush" Color="#2DB88F" />
                    <SolidColorBrush x:Key="ShiftFlowGreenMutedBrush" Color="#1F3D34" />
                    <SolidColorBrush x:Key="ShiftCardBgBrush" Color="#1E2023" />
                    <SolidColorBrush x:Key="ShiftSubtleBgBrush" Color="#22FFFFFF" />
                    <SolidColorBrush x:Key="ShiftTrackBrush" Color="#2A2D32" />
                    <SolidColorBrush x:Key="ShiftTextPrimaryBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="ShiftTextSecondaryBrush" Color="#CBD5E1" />
                    <SolidColorBrush x:Key="ShiftTextMutedBrush" Color="#94A3B8" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
