<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="FlowWindows_App.Controls.CircularTimerControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    SizeChanged="OnSizeChanged">

    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
        <Canvas x:Name="TimerCanvas" Width="320" Height="320">
            <!-- Background Track Circle -->
            <Path x:Name="BackgroundPath" StrokeThickness="8">
                <Path.Data>
                    <PathGeometry>
                        <PathFigure x:Name="BgFigure" StartPoint="160, 20">
                            <ArcSegment x:Name="BgArc1" Point="160, 300" Size="140, 140" SweepDirection="Clockwise" IsLargeArc="True" />
                            <ArcSegment x:Name="BgArc2" Point="160, 20" Size="140, 140" SweepDirection="Clockwise" IsLargeArc="True" />
                        </PathFigure>
                    </PathGeometry>
                </Path.Data>
            </Path>

            <!-- Foreground Progress Arc -->
            <Path x:Name="ProgressPath" StrokeThickness="8" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                <Path.Data>
                    <PathGeometry>
                        <PathFigure x:Name="ProgressFigure" StartPoint="160, 20" IsClosed="False">
                            <ArcSegment x:Name="ProgressArc" Size="140, 140" SweepDirection="Clockwise" />
                        </PathFigure>
                    </PathGeometry>
                </Path.Data>
            </Path>
        </Canvas>

        <!-- Center Content -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
            <!-- Cycle Dots -->
            <StackPanel x:Name="CycleDotsPanel" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="6" Margin="0,0,0,4">
                <!-- Dots populated dynamically in code-behind -->
            </StackPanel>

            <!-- Countdown Text -->
            <TextBlock x:Name="TimeText"
                       Text="25:00"
                       FontSize="58"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif" />

            <!-- Session Type Label -->
            <TextBlock x:Name="SessionTypeLabel"
                       Text="FOCUS"
                       FontSize="13"
                       FontWeight="Bold"
                       CharacterSpacing="120"
                       HorizontalAlignment="Center"
                       Opacity="0.6" />

            <!-- Tag / Task pill -->
            <Border x:Name="TagPillBorder"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    CornerRadius="12"
                    Padding="10,4"
                    HorizontalAlignment="Center"
                    Visibility="Collapsed"
                    Margin="0,4,0,0">
                <TextBlock x:Name="TagPillText" FontSize="12" FontWeight="Medium" />
            </Border>
        </StackPanel>
    </Grid>
</UserControl>

