<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="FlowWindows_App.Pages.StudyPlannerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Padding="28" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="24" MaxWidth="960" HorizontalAlignment="Stretch">
            <!-- Header -->
            <Grid>
                <Button Width="32" Height="32" Padding="0" CornerRadius="16" Background="Transparent" BorderThickness="0"
                        HorizontalAlignment="Left" ToolTipService.ToolTip="Back to Timer" Click="OnBackClicked">
                    <FontIcon Glyph="&#xE72B;" FontSize="14" />
                </Button>
                <StackPanel Margin="42,0,0,0">
                    <TextBlock Text="Study Planner" FontSize="20" FontWeight="Bold" Foreground="{ThemeResource ShiftTextPrimaryBrush}" />
                    <TextBlock Text="Track syllabus coverage, topics, units, and exam deadlines" FontSize="12" Foreground="{ThemeResource ShiftTextSecondaryBrush}" Margin="0,2,0,0" />
                </StackPanel>
            </Grid>

            <!-- Status Notice -->
            <InfoBar x:Name="StudyStatusInfoBar" IsOpen="False" Severity="Success" />

            <!-- Quick Add Subject Card -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="20">
                <StackPanel Spacing="14">
                    <TextBlock Text="Add New Course or Subject" FontSize="16" FontWeight="SemiBold" />
                    
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="SubjectNameBox" PlaceholderText="Subject Name (e.g. Computer Networks)" CornerRadius="12" />
                        
                        <NumberBox x:Name="TargetHoursBox" Grid.Column="1" Value="20" Minimum="1" Maximum="500" SpinButtonPlacementMode="Inline" CornerRadius="12" PlaceholderText="Target Hours" />

                        <DatePicker x:Name="ExamDatePicker" Grid.Column="2" HorizontalAlignment="Stretch" CornerRadius="12" />

                        <Button Grid.Column="3" Style="{ThemeResource AccentButtonStyle}" CornerRadius="12" Padding="18,6" Click="OnAddSubjectClicked">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE710;" FontSize="12" />
                                <TextBlock Text="Add Subject" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Subjects Grid / List -->
            <StackPanel Spacing="16">
                <TextBlock Text="Your Subjects" FontSize="18" FontWeight="SemiBold" />

                <!-- Empty State Message -->
                <Border x:Name="EmptySubjectsBorder"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="32,24"
                        HorizontalAlignment="Stretch"
                        Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center" Spacing="8">
                        <FontIcon Glyph="&#xE82D;" FontSize="28" Foreground="{ThemeResource ShiftTextSecondaryBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="No subjects or courses added yet" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{ThemeResource ShiftTextPrimaryBrush}" />
                        <TextBlock Text="Add your subjects above to organize study blocks, track exam countdowns, and customize units." FontSize="13" Foreground="{ThemeResource ShiftTextSecondaryBrush}" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>

                <ListView x:Name="SubjectsListView" SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="20"
                                    Margin="0,8">
                                <StackPanel Spacing="14">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                            <Border Width="12" Height="12" CornerRadius="6" Background="{Binding ColorBrush}" />
                                            <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="Bold" />
                                            <Border Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="8" Padding="8,2" Margin="6,0,0,0">
                                                <TextBlock Text="{Binding ExamCountdownText}" FontSize="11" FontWeight="SemiBold" Foreground="#60A5FA" />
                                            </Border>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                                            <!-- Study Now Button -->
                                            <Button Tag="{Binding Id}" Style="{ThemeResource AccentButtonStyle}" CornerRadius="10" Padding="12,4" Click="OnStudySubjectClicked">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon Glyph="&#xE768;" FontSize="11" />
                                                    <TextBlock Text="Study Now" FontSize="12" />
                                                </StackPanel>
                                            </Button>

                                            <!-- Edit Subject Button with Flyout -->
                                            <Button Width="32" Height="32" Padding="0" CornerRadius="16" ToolTipService.ToolTip="Edit Subject">
                                                <FontIcon Glyph="&#xE70F;" FontSize="12" />
                                                <Button.Flyout>
                                                    <Flyout>
                                                        <StackPanel Spacing="10" Width="260">
                                                            <TextBlock Text="Edit Course / Subject" FontWeight="Bold" FontSize="14" Foreground="{ThemeResource ShiftTextPrimaryBrush}" />
                                                            <TextBox x:Name="EditSubjectNameBox" Header="Subject Name" Text="{Binding Name}" CornerRadius="8" />
                                                            <NumberBox x:Name="EditTargetHoursBox" Header="Target Hours" Value="{Binding TargetHours}" Minimum="1" Maximum="1000" SpinButtonPlacementMode="Inline" CornerRadius="8" />
                                                            <Button Content="Save Changes" Style="{ThemeResource AccentButtonStyle}" HorizontalAlignment="Stretch" CornerRadius="8"
                                                                    Tag="{Binding Id}" Click="OnSaveSubjectEditedClicked" />
                                                        </StackPanel>
                                                    </Flyout>
                                                </Button.Flyout>
                                            </Button>

                                            <!-- Delete Subject Button -->
                                            <Button Tag="{Binding Id}" Width="32" Height="32" Padding="0" CornerRadius="16" ToolTipService.ToolTip="Delete Subject" Click="OnDeleteSubjectClicked">
                                                <FontIcon Glyph="&#xE74D;" FontSize="12" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Hours Progress Bar -->
                                    <StackPanel Spacing="4">
                                        <Grid>
                                            <TextBlock Text="Study Hours Logged" FontSize="12" Foreground="{ThemeResource ShiftTextSecondaryBrush}" />
                                            <TextBlock Text="{Binding HoursProgressText}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource ShiftTextPrimaryBrush}" HorizontalAlignment="Right" />
                                        </Grid>
                                        <ProgressBar Value="{Binding ProgressPercent}" Maximum="100" Height="6" CornerRadius="3" Foreground="{Binding ColorBrush}" />
                                    </StackPanel>

                                    <!-- Topics Section -->
                                    <Border Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="8" Padding="14">
                                        <StackPanel Spacing="10">
                                            <Grid>
                                                <TextBlock Text="Key Topics &amp; Units" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource ShiftTextPrimaryBrush}" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding TopicsCountText}" FontSize="11" Foreground="{ThemeResource ShiftTextSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            </Grid>

                                            <!-- Add Topic Row -->
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="100" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <TextBox x:Name="NewTopicTitleBox" PlaceholderText="New topic / unit name..." CornerRadius="8" />
                                                <NumberBox x:Name="NewTopicHoursBox" Grid.Column="1" Value="2" Minimum="0.5" Maximum="100" SpinButtonPlacementMode="Inline" CornerRadius="8" PlaceholderText="Est. Hrs" />
                                                <Button Grid.Column="2" Tag="{Binding Id}" CornerRadius="8" Padding="10,4" ToolTipService.ToolTip="Add Topic" Click="OnAddTopicClicked">
                                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                                        <FontIcon Glyph="&#xE710;" FontSize="11" />
                                                        <TextBlock Text="Add" FontSize="12" />
                                                    </StackPanel>
                                                </Button>
                                            </Grid>

                                            <!-- Topics List -->
                                            <ListView ItemsSource="{Binding Topics}" SelectionMode="None">
                                                <ListView.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Padding="4,4">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>

                                                            <CheckBox IsChecked="{Binding IsCompleted}" Tag="{Binding Id}" Click="OnTopicCheckboxClicked" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                            
                                                            <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="13" Foreground="{ThemeResource ShiftTextPrimaryBrush}" VerticalAlignment="Center" />
                                                            
                                                            <TextBlock Grid.Column="2" Text="{Binding EstimatedHoursText}" Margin="12,0" FontSize="11" Foreground="{ThemeResource ShiftTextSecondaryBrush}" VerticalAlignment="Center" />

                                                            <Button Grid.Column="3" Tag="{Binding Id}" Width="28" Height="28" Padding="0" CornerRadius="14" ToolTipService.ToolTip="Delete Topic" Click="OnDeleteTopicClicked">
                                                                <FontIcon Glyph="&#xE711;" FontSize="10" />
                                                            </Button>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ListView.ItemTemplate>
                                            </ListView>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
