<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="FlowWindows_App.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Padding="28" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="24" MaxWidth="960" HorizontalAlignment="Stretch">
            <!-- Header -->
            <Grid>
                <Button Width="32" Height="32" Padding="0" CornerRadius="16" Background="Transparent" BorderThickness="0"
                        HorizontalAlignment="Left" ToolTipService.ToolTip="Back to Timer" Click="OnBackClicked">
                    <FontIcon Glyph="&#xE72B;" FontSize="14" />
                </Button>
                <StackPanel Margin="42,0,0,0">
                    <TextBlock Text="Settings &amp; Preferences" FontSize="20" FontWeight="Bold" />
                    <TextBlock Text="Configure timing rules, sounds, commitment policies, and local data" FontSize="12" Opacity="0.6" Margin="0,2,0,0" />
                </StackPanel>
            </Grid>

            <!-- Status Notice -->
            <InfoBar x:Name="SettingsStatusInfoBar" IsOpen="False" Severity="Success" Message="Settings updated successfully." />

            <!-- Timer Defaults Section -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="20">
                <StackPanel Spacing="16">
                    <TextBlock Text="Timer Configuration" FontSize="16" FontWeight="SemiBold" />
                    
                    <Grid RowSpacing="14" ColumnSpacing="20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="200" />
                        </Grid.ColumnDefinitions>

                        <!-- Focus Duration -->
                        <StackPanel Grid.Row="0">
                            <TextBlock Text="Focus Session Duration" FontWeight="Medium" />
                            <TextBlock Text="Standard focus block length in minutes" FontSize="12" Opacity="0.6" />
                        </StackPanel>
                        <NumberBox x:Name="FocusDurationBox" Grid.Row="0" Grid.Column="1" Minimum="1" Maximum="180" SpinButtonPlacementMode="Inline" ValueChanged="OnSettingChanged" />

                        <!-- Short Break -->
                        <StackPanel Grid.Row="1">
                            <TextBlock Text="Short Break Duration" FontWeight="Medium" />
                            <TextBlock Text="Rest period between standard focus sessions" FontSize="12" Opacity="0.6" />
                        </StackPanel>
                        <NumberBox x:Name="ShortBreakDurationBox" Grid.Row="1" Grid.Column="1" Minimum="1" Maximum="60" SpinButtonPlacementMode="Inline" ValueChanged="OnSettingChanged" />

                        <!-- Long Break -->
                        <StackPanel Grid.Row="2">
                            <TextBlock Text="Long Break Duration" FontWeight="Medium" />
                            <TextBlock Text="Extended recovery period after completing a full cycle" FontSize="12" Opacity="0.6" />
                        </StackPanel>
                        <NumberBox x:Name="LongBreakDurationBox" Grid.Row="2" Grid.Column="1" Minimum="1" Maximum="120" SpinButtonPlacementMode="Inline" ValueChanged="OnSettingChanged" />

                        <!-- Sessions Before Long Break -->
                        <StackPanel Grid.Row="3">
                            <TextBlock Text="Sessions Before Long Break" FontWeight="Medium" />
                            <TextBlock Text="Number of focus cycles required before triggering a long break" FontSize="12" Opacity="0.6" />
                        </StackPanel>
                        <NumberBox x:Name="CyclesBeforeLongBreakBox" Grid.Row="3" Grid.Column="1" Minimum="1" Maximum="12" SpinButtonPlacementMode="Inline" ValueChanged="OnSettingChanged" />

                        <!-- Auto Transitions -->
                        <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="40" Margin="0,6,0,0">
                            <ToggleSwitch x:Name="AutoStartBreaksSwitch" Header="Auto-start Breaks" Toggled="OnSettingChanged" />
                            <ToggleSwitch x:Name="AutoStartFocusSwitch" Header="Auto-start Focus" Toggled="OnSettingChanged" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Commitment Mode -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="20">
                <StackPanel Spacing="14">
                    <TextBlock Text="Commitment Mode" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="Lock timer controls during active focus to enforce discipline." FontSize="12" Opacity="0.6" />

                    <ComboBox x:Name="CommitmentModeCombo" Width="240" CornerRadius="12" SelectionChanged="OnSettingChanged">
                        <ComboBoxItem Content="Off (Flexible control)" Tag="0" />
                        <ComboBoxItem Content="Gentle (Warn before reset/skip)" Tag="1" />
                        <ComboBoxItem Content="Strict (Lock controls during session)" Tag="2" />
                        <ComboBoxItem Content="Hardcore (Full focus lock)" Tag="3" />
                    </ComboBox>
                </StackPanel>
            </Border>

            <!-- Sound & Audio Section -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="20">
                <StackPanel Spacing="16">
                    <TextBlock Text="Audio &amp; Sounds" FontSize="16" FontWeight="SemiBold" />

                    <Grid RowSpacing="14" ColumnSpacing="20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>

                        <!-- Sound On Completion Toggle -->
                        <ToggleSwitch x:Name="PlaySoundSwitch" Header="Audio Tones on Completion" Grid.Row="0" Grid.ColumnSpan="2" Toggled="OnSettingChanged" />

                        <!-- Focus Sound -->
                        <TextBlock Text="Focus Completion Tone" Grid.Row="1" VerticalAlignment="Center" FontWeight="Medium" />
                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <ComboBox x:Name="FocusSoundCombo" Width="160" CornerRadius="12" SelectionChanged="OnSettingChanged">
                                <ComboBoxItem Content="Chime" Tag="2" />
                                <ComboBoxItem Content="Bell" Tag="1" />
                                <ComboBoxItem Content="Gentle Gong" Tag="3" />
                                <ComboBoxItem Content="Digital Alert" Tag="4" />
                                <ComboBoxItem Content="Minimal Beep" Tag="5" />
                            </ComboBox>
                            <Button ToolTipService.ToolTip="Preview Sound" CornerRadius="8" Padding="8,4" Click="OnPreviewFocusSoundClicked">
                                <FontIcon Glyph="&#xE768;" FontSize="12" />
                            </Button>
                        </StackPanel>

                        <!-- Break Sound -->
                        <TextBlock Text="Break Completion Tone" Grid.Row="2" VerticalAlignment="Center" FontWeight="Medium" />
                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <ComboBox x:Name="BreakSoundCombo" Width="160" CornerRadius="12" SelectionChanged="OnSettingChanged">
                                <ComboBoxItem Content="Bell" Tag="1" />
                                <ComboBoxItem Content="Chime" Tag="2" />
                                <ComboBoxItem Content="Gentle Gong" Tag="3" />
                                <ComboBoxItem Content="Digital Alert" Tag="4" />
                                <ComboBoxItem Content="Minimal Beep" Tag="5" />
                            </ComboBox>
                            <Button ToolTipService.ToolTip="Preview Sound" CornerRadius="8" Padding="8,4" Click="OnPreviewBreakSoundClicked">
                                <FontIcon Glyph="&#xE768;" FontSize="12" />
                            </Button>
                        </StackPanel>

                        <!-- Sound Volume -->
                        <TextBlock Text="Volume" Grid.Row="3" VerticalAlignment="Center" FontWeight="Medium" />
                        <Slider x:Name="SoundVolumeSlider" Grid.Row="3" Grid.Column="1" Minimum="10" Maximum="100" Value="80" ValueChanged="OnSettingChanged" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- General & Window Options -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="20">
                <StackPanel Spacing="14">
                    <TextBlock Text="Window &amp; Taskbar Integration" FontSize="16" FontWeight="SemiBold" />

                    <ToggleSwitch x:Name="MinimizeToTraySwitch" Header="Minimize to System Tray on Window Close" Toggled="OnSettingChanged" />
                    <ToggleSwitch x:Name="WindowsNotificationsSwitch" Header="Show Native Windows Notifications" Toggled="OnSettingChanged" />
                    <ToggleSwitch x:Name="MiniTimerAlwaysOnTopSwitch" Header="Keep Mini Timer Always On Top" Toggled="OnSettingChanged" />
                </StackPanel>
            </Border>

            <!-- Data Management & Local Export Section -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="20">
                <StackPanel Spacing="16">
                    <TextBlock Text="Data Management, Reports &amp; Backups" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="All information is stored locally on this machine (%LOCALAPPDATA%\FlowWindows\Database\flow.db). No external accounts or cloud services required." FontSize="12" Opacity="0.6" />

                    <Grid ColumnSpacing="12" RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Row="0" Grid.Column="0" HorizontalAlignment="Stretch" CornerRadius="10" Padding="14,8" Click="OnExportCsvClicked">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8B7;" FontSize="14" />
                                <TextBlock Text="Export Session History (CSV)" />
                            </StackPanel>
                        </Button>

                        <Button Grid.Row="0" Grid.Column="1" HorizontalAlignment="Stretch" CornerRadius="10" Padding="14,8" Click="OnExportReportClicked">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE72D;" FontSize="14" />
                                <TextBlock Text="Generate Printable Report (HTML / PDF)" />
                            </StackPanel>
                        </Button>

                        <Button Grid.Row="1" Grid.Column="0" HorizontalAlignment="Stretch" CornerRadius="10" Padding="14,8" Click="OnBackupDatabaseClicked">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xEA35;" FontSize="14" />
                                <TextBlock Text="Create Database Backup" />
                            </StackPanel>
                        </Button>

                        <Button Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch" CornerRadius="10" Padding="14,8" Click="OnRestoreDatabaseClicked">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE777;" FontSize="14" />
                                <TextBlock Text="Restore from Backup" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- About Section -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="20">
                <StackPanel Spacing="6">
                    <TextBlock Text="Flow for Windows" FontSize="16" FontWeight="Bold" />
                    <TextBlock Text="Version 1.0.0 (Windows x64 Native)" FontSize="12" Opacity="0.7" />
                    <TextBlock Text="Crafted with modern .NET 8, WinUI 3 (Windows App SDK), and SQLite. Designed for high focus, minimal distraction, and local privacy." FontSize="12" Opacity="0.5" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>

