<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="FlowWindows_App.Pages.InsightsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Padding="28" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="24" MaxWidth="960" HorizontalAlignment="Stretch">
            <!-- Header -->
            <Grid>
                <Button Width="32" Height="32" Padding="0" CornerRadius="16" Background="Transparent" BorderThickness="0"
                        HorizontalAlignment="Left" ToolTipService.ToolTip="Back to Timer" Click="OnBackClicked">
                    <FontIcon Glyph="&#xE72B;" FontSize="14" />
                </Button>
                <StackPanel Margin="42,0,0,0">
                    <TextBlock Text="Productivity Insights &amp; Goals" FontSize="20" FontWeight="Bold" />
                    <TextBlock Text="Algorithmic patterns, focus rhythms, and achievement milestones" FontSize="12" Opacity="0.6" Margin="0,2,0,0" />
                </StackPanel>
            </Grid>

            <!-- Insights Section -->
            <StackPanel Spacing="12">
                <TextBlock Text="Behavioral Observations" FontSize="18" FontWeight="SemiBold" />
                
                <ItemsControl x:Name="InsightsItemsControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="18,14"
                                    Margin="0,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Width="40" Height="40" CornerRadius="20" Background="#26FF5252" Margin="0,0,16,0" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE782;" Foreground="#FF5252" FontSize="18" />
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Description}" FontSize="13" Opacity="0.7" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- Goals Section -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="20">
                <StackPanel Spacing="16">
                    <TextBlock Text="Active Targets &amp; Commitments" FontSize="16" FontWeight="SemiBold" />

                    <ListView x:Name="GoalsListView" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Spacing="6" Margin="0,6">
                                    <Grid>
                                        <TextBlock Text="{Binding Title}" FontWeight="Medium" FontSize="14" />
                                        <TextBlock Text="{Binding ProgressText}" HorizontalAlignment="Right" FontSize="12" FontWeight="SemiBold" />
                                    </Grid>
                                    <ProgressBar Value="{Binding ProgressPercentage}" Maximum="100" Height="8" CornerRadius="4" Foreground="#448AFF" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>

            <!-- Achievements Showcase -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="20">
                <StackPanel Spacing="16">
                    <TextBlock Text="Achievements &amp; Milestones" FontSize="16" FontWeight="SemiBold" />

                    <ListView x:Name="AchievementsListView" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="6,10" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,0.5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Width="36" Height="36" CornerRadius="18" Background="{Binding BadgeBackground}" Margin="0,0,14,0" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE734;" Foreground="{Binding BadgeForeground}" FontSize="16" />
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Description}" FontSize="12" Opacity="0.6" />
                                    </StackPanel>

                                    <Border Grid.Column="2" Background="{Binding StatusBackground}" CornerRadius="10" Padding="10,3" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="Bold" Foreground="{Binding StatusForeground}" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>

