<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="FlowWindows_App.Pages.InsightsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Padding="28" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="24" MaxWidth="960" HorizontalAlignment="Stretch">
            <!-- Header -->
            <Grid>
                <Button Width="32" Height="32" Padding="0" CornerRadius="16" Background="Transparent" BorderThickness="0"
                        HorizontalAlignment="Left" ToolTipService.ToolTip="Back to Timer" Click="OnBackClicked">
                    <FontIcon Glyph="&#xE72B;" FontSize="14" />
                </Button>
                <StackPanel Margin="42,0,0,0">
                    <TextBlock Text="Productivity Insights &amp; Goals" FontSize="20" FontWeight="Bold" Foreground="{ThemeResource ShiftTextPrimaryBrush}" />
                    <TextBlock Text="Custom targets, behavioral patterns, and achievement milestones" FontSize="12" Foreground="{ThemeResource ShiftTextSecondaryBrush}" Margin="0,2,0,0" />
                </StackPanel>
            </Grid>

            <!-- Status Notice -->
            <InfoBar x:Name="GoalStatusInfoBar" IsOpen="False" Severity="Success" />

            <!-- Create Custom Goal Card -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="20">
                <StackPanel Spacing="14">
                    <TextBlock Text="Create New Goal or Target" FontSize="16" FontWeight="SemiBold" />
                    
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="NewGoalTitleBox" PlaceholderText="Goal Name (e.g. Master React, Deep Coding)" CornerRadius="12" />
                        
                        <ComboBox x:Name="NewGoalTypeCombo" Grid.Column="1" HorizontalAlignment="Stretch" CornerRadius="12" SelectedIndex="0">
                            <ComboBoxItem Content="Daily Focus (Minutes)" Tag="0" />
                            <ComboBoxItem Content="Weekly Focus (Minutes)" Tag="1" />
                            <ComboBoxItem Content="Daily Sessions" Tag="3" />
                            <ComboBoxItem Content="Weekly Sessions" Tag="4" />
                        </ComboBox>

                        <NumberBox x:Name="NewGoalTargetBox" Grid.Column="2" Value="120" Minimum="1" Maximum="10000" SpinButtonPlacementMode="Inline" CornerRadius="12" PlaceholderText="Target" />

                        <Button Grid.Column="3" Style="{ThemeResource AccentButtonStyle}" CornerRadius="12" Padding="18,6" Click="OnAddGoalClicked">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE710;" FontSize="12" />
                                <TextBlock Text="Add Goal" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Goals Section -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="20">
                <StackPanel Spacing="16">
                    <Grid>
                        <TextBlock Text="Active Targets &amp; Commitments" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource ShiftTextPrimaryBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="Customizable targets" FontSize="12" Foreground="{ThemeResource ShiftTextSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>

                    <ListView x:Name="GoalsListView" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="10" Padding="16,12" Margin="0,4">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Goal Title & Target -->
                                        <StackPanel Grid.Row="0" Grid.Column="0" Spacing="2">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" Foreground="{ThemeResource ShiftTextPrimaryBrush}" />
                                            <TextBlock Text="{Binding ProgressText}" FontSize="12" Foreground="{ThemeResource ShiftTextSecondaryBrush}" />
                                        </StackPanel>

                                        <!-- Action Buttons: Edit, Reset, Delete -->
                                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <!-- Edit Goal Button with Flyout -->
                                            <Button Width="32" Height="32" Padding="0" CornerRadius="16" ToolTipService.ToolTip="Edit Target">
                                                <FontIcon Glyph="&#xE70F;" FontSize="12" />
                                                <Button.Flyout>
                                                    <Flyout>
                                                        <StackPanel Spacing="10" Width="240">
                                                            <TextBlock Text="Edit Goal Target" FontWeight="Bold" FontSize="13" />
                                                            <TextBox x:Name="EditTitleBox" Header="Title" Text="{Binding Title}" CornerRadius="8" />
                                                            <NumberBox x:Name="EditTargetBox" Header="Target Value" Value="{Binding TargetValue}" Minimum="1" Maximum="10000" SpinButtonPlacementMode="Inline" CornerRadius="8" />
                                                            <Button Content="Save Changes" Style="{ThemeResource AccentButtonStyle}" HorizontalAlignment="Stretch" CornerRadius="8"
                                                                    Tag="{Binding Id}" Click="OnSaveGoalEditedClicked" />
                                                        </StackPanel>
                                                    </Flyout>
                                                </Button.Flyout>
                                            </Button>

                                            <!-- Reset Progress Button -->
                                            <Button Tag="{Binding Id}" Width="32" Height="32" Padding="0" CornerRadius="16" ToolTipService.ToolTip="Reset Progress to 0" Click="OnResetGoalClicked">
                                                <FontIcon Glyph="&#xE72C;" FontSize="12" />
                                            </Button>

                                            <!-- Delete Button -->
                                            <Button Tag="{Binding Id}" Width="32" Height="32" Padding="0" CornerRadius="16" ToolTipService.ToolTip="Delete Goal" Click="OnDeleteGoalClicked">
                                                <FontIcon Glyph="&#xE74D;" FontSize="12" />
                                            </Button>
                                        </StackPanel>

                                        <!-- Progress Bar -->
                                        <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" Margin="0,8,0,0" Value="{Binding ProgressPercentage}" Maximum="100" Height="8" CornerRadius="4" Foreground="#448AFF" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>

            <!-- Insights Section -->
            <StackPanel Spacing="12">
                <Grid>
                    <TextBlock Text="Behavioral Observations &amp; Rhythms" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button HorizontalAlignment="Right" CornerRadius="10" Padding="12,4" Click="OnRefreshInsightsClicked">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE72C;" FontSize="11" />
                            <TextBlock Text="Re-Analyze" FontSize="12" />
                        </StackPanel>
                    </Button>
                </Grid>
                
                <ItemsControl x:Name="InsightsItemsControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="18,14"
                                    Margin="0,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Width="40" Height="40" CornerRadius="20" Background="#26448AFF" Margin="0,0,16,0" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE782;" Foreground="#448AFF" FontSize="18" />
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource ShiftTextPrimaryBrush}" />
                                        <TextBlock Text="{Binding Description}" FontSize="13" Foreground="{ThemeResource ShiftTextSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- Achievements Showcase -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="20">
                <StackPanel Spacing="16">
                    <TextBlock Text="Achievements &amp; Milestones" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource ShiftTextPrimaryBrush}" />

                    <ListView x:Name="AchievementsListView" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="6,10" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,0.5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Width="36" Height="36" CornerRadius="18" Background="{Binding BadgeBackground}" Margin="0,0,14,0" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE734;" Foreground="{Binding BadgeForeground}" FontSize="16" />
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource ShiftTextPrimaryBrush}" />
                                        <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{ThemeResource ShiftTextSecondaryBrush}" />
                                    </StackPanel>

                                    <Border Grid.Column="2" Background="{Binding StatusBackground}" CornerRadius="10" Padding="10,3" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="Bold" Foreground="{Binding StatusForeground}" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
