<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="FlowWindows_App.Pages.TasksPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Padding="28" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="24" MaxWidth="960" HorizontalAlignment="Stretch">
            <!-- Header -->
            <Grid>
                <Button Width="32" Height="32" Padding="0" CornerRadius="16" Background="Transparent" BorderThickness="0"
                        HorizontalAlignment="Left" ToolTipService.ToolTip="Back to Timer" Click="OnBackClicked">
                    <FontIcon Glyph="&#xE72B;" FontSize="14" />
                </Button>
                <StackPanel Margin="42,0,0,0">
                    <TextBlock Text="Tasks &amp; Action Items" FontSize="20" FontWeight="Bold" Foreground="{ThemeResource ShiftTextPrimaryBrush}" />
                    <TextBlock Text="Manage, customize, and link high-priority tasks to focus blocks" FontSize="12" Foreground="{ThemeResource ShiftTextSecondaryBrush}" Margin="0,2,0,0" />
                </StackPanel>
            </Grid>

            <!-- Status Notice -->
            <InfoBar x:Name="TaskStatusInfoBar" IsOpen="False" Severity="Success" />

            <!-- Quick Add Task Card -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="20">
                <StackPanel Spacing="14">
                    <TextBlock Text="Add New Task" FontSize="16" FontWeight="SemiBold" />
                    
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="NewTaskTitleBox" PlaceholderText="What are you working on?" CornerRadius="12" />
                        
                        <ComboBox x:Name="PriorityComboBox" Grid.Column="1" PlaceholderText="Priority" CornerRadius="12" HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="Low" />
                            <ComboBoxItem Content="Medium" IsSelected="True" />
                            <ComboBoxItem Content="High" />
                        </ComboBox>

                        <NumberBox x:Name="EstMinutesBox" Grid.Column="2" Value="25" Minimum="5" Maximum="240" SpinButtonPlacementMode="Inline" CornerRadius="12" PlaceholderText="Est. Mins" />

                        <Button Grid.Column="3" Style="{ThemeResource AccentButtonStyle}" CornerRadius="12" Padding="18,6" Click="OnAddTaskClicked">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE710;" FontSize="12" />
                                <TextBlock Text="Add Task" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Search and Filter Bar -->
            <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBox x:Name="SearchTasksBox" PlaceholderText="Search tasks..." CornerRadius="10" TextChanged="OnSearchTasksChanged" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                    <Button x:Name="FilterAllBtn" Content="All" CornerRadius="10" Padding="10,2" Click="OnFilterAllClicked" />
                    <Button x:Name="FilterPendingBtn" Content="Pending" CornerRadius="10" Padding="10,2" Click="OnFilterPendingClicked" />
                    <Button x:Name="FilterCompletedBtn" Content="Completed" CornerRadius="10" Padding="10,2" Click="OnFilterCompletedClicked" />
                    <Button Content="Clear Completed" CornerRadius="10" Padding="10,2" ToolTipService.ToolTip="Remove all completed tasks" Click="OnClearCompletedClicked" />
                </StackPanel>
            </Grid>

            <!-- Tasks List -->
            <StackPanel Spacing="12">
                <!-- Empty State Message -->
                <Border x:Name="EmptyTasksBorder"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="32,24"
                        HorizontalAlignment="Stretch"
                        Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center" Spacing="8">
                        <FontIcon Glyph="&#xE762;" FontSize="28" Foreground="{ThemeResource ShiftTextSecondaryBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="No tasks found" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{ThemeResource ShiftTextPrimaryBrush}" />
                        <TextBlock Text="Add a task above to plan and link work directly to your focus timer." FontSize="13" Foreground="{ThemeResource ShiftTextSecondaryBrush}" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>

                <ListView x:Name="TasksListView" SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="16,12"
                                    Margin="0,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Checkbox -->
                                    <CheckBox IsChecked="{Binding IsChecked}"
                                              Tag="{Binding Id}"
                                              Click="OnTaskCheckboxClicked"
                                              VerticalAlignment="Center"
                                              Margin="0,0,12,0" />

                                    <!-- Details -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" />
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <Border Background="{Binding PriorityBadgeBrush}" CornerRadius="6" Padding="6,1">
                                                <TextBlock Text="{Binding PriorityText}" FontSize="11" FontWeight="Bold" Foreground="{Binding PriorityTextBrush}" />
                                            </Border>
                                            <TextBlock Text="{Binding DurationText}" FontSize="12" Foreground="{ThemeResource ShiftTextSecondaryBrush}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Edit Task Flyout Button -->
                                    <Button Grid.Column="2"
                                            Width="32" Height="32"
                                            Padding="0"
                                            CornerRadius="16"
                                            Margin="4,0"
                                            VerticalAlignment="Center"
                                            ToolTipService.ToolTip="Edit Task">
                                        <FontIcon Glyph="&#xE70F;" FontSize="12" />
                                        <Button.Flyout>
                                            <Flyout>
                                                <StackPanel Spacing="10" Width="260">
                                                    <TextBlock Text="Edit Task" FontWeight="Bold" FontSize="14" />
                                                    <TextBox x:Name="EditTaskTitleBox" Header="Title" Text="{Binding Title}" CornerRadius="8" />
                                                    <ComboBox x:Name="EditPriorityCombo" Header="Priority" SelectedIndex="{Binding PriorityIndex}" HorizontalAlignment="Stretch" CornerRadius="8">
                                                        <ComboBoxItem Content="Low" />
                                                        <ComboBoxItem Content="Medium" />
                                                        <ComboBoxItem Content="High" />
                                                    </ComboBox>
                                                    <NumberBox x:Name="EditEstMinutesBox" Header="Estimated Minutes" Value="{Binding EstimatedMinutes}" Minimum="5" Maximum="480" SpinButtonPlacementMode="Inline" CornerRadius="8" />
                                                    <Button Content="Save Changes" Style="{ThemeResource AccentButtonStyle}" HorizontalAlignment="Stretch" CornerRadius="8"
                                                            Tag="{Binding Id}" Click="OnSaveTaskEditedClicked" />
                                                </StackPanel>
                                            </Flyout>
                                        </Button.Flyout>
                                    </Button>

                                    <!-- Focus On Task Button -->
                                    <Button Grid.Column="3"
                                            Tag="{Binding Id}"
                                            CornerRadius="12"
                                            Padding="12,4"
                                            Margin="4,0"
                                            VerticalAlignment="Center"
                                            Click="OnFocusTaskClicked">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE768;" FontSize="11" />
                                            <TextBlock Text="Focus" FontSize="12" />
                                        </StackPanel>
                                    </Button>

                                    <!-- Delete Button -->
                                    <Button Grid.Column="4"
                                            Tag="{Binding Id}"
                                            Width="32" Height="32"
                                            Padding="0"
                                            CornerRadius="16"
                                            VerticalAlignment="Center"
                                            ToolTipService.ToolTip="Delete Task"
                                            Click="OnDeleteTaskClicked">
                                        <FontIcon Glyph="&#xE74D;" FontSize="12" />
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
