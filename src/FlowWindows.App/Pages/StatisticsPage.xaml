<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="FlowWindows_App.Pages.StatisticsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Padding="20,16" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="18" MaxWidth="560" HorizontalAlignment="Stretch">
            <!-- Top Bar: Back Button & Segmented Period Control [ D | W | M | Y ] -->
            <Grid>
                <!-- Back to Timer Button -->
                <Button x:Name="BackToTimerButton"
                        Width="32" Height="32" Padding="0"
                        CornerRadius="16" Background="Transparent" BorderThickness="0"
                        HorizontalAlignment="Left"
                        ToolTipService.ToolTip="Back to Timer"
                        Click="OnBackClicked">
                    <FontIcon Glyph="&#xE72B;" FontSize="14" />
                </Button>

                <!-- Flow Segmented Switcher [ D | W | M | Y ] -->
                <Border Background="{ThemeResource ShiftSubtleBgBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="2"
                        HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="2">
                        <Button x:Name="PeriodDayBtn" Content="D" Width="36" Height="28" Padding="0" CornerRadius="12" Click="OnPeriodDayClicked" />
                        <Button x:Name="PeriodWeekBtn" Content="W" Width="36" Height="28" Padding="0" CornerRadius="12" Click="OnPeriodWeekClicked" />
                        <Button x:Name="PeriodMonthBtn" Content="M" Width="36" Height="28" Padding="0" CornerRadius="12" Click="OnPeriodMonthClicked" />
                        <Button x:Name="PeriodYearBtn" Content="Y" Width="36" Height="28" Padding="0" CornerRadius="12" Click="OnPeriodYearClicked" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Date Range & Summary Header: <  March 13-19, 2026 — 42 Shifts  > -->
            <Grid HorizontalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Button x:Name="PrevPeriodBtn"
                            Width="28" Height="28" Padding="0"
                            CornerRadius="14" Background="Transparent" BorderThickness="0"
                            Click="OnPrevPeriodClicked">
                        <FontIcon Glyph="&#xE76B;" FontSize="10" Opacity="0.6" />
                    </Button>

                    <TextBlock x:Name="DateRangeSummaryText"
                               Text="March 13–19, 2026 — 42 Shifts"
                               FontSize="16"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />

                    <Button x:Name="NextPeriodBtn"
                            Width="28" Height="28" Padding="0"
                            CornerRadius="14" Background="Transparent" BorderThickness="0"
                            Click="OnNextPeriodClicked">
                        <FontIcon Glyph="&#xE76C;" FontSize="10" Opacity="0.6" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Flow Signature Capsule Bar Chart (Image 1) -->
            <Border Background="{ThemeResource ShiftCardBgBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="16,20">
                <StackPanel Spacing="16">
                    <!-- Chart Bars Container (M, T, W, T, F, S, S) -->
                    <Grid x:Name="ChartGrid" Height="170" HorizontalAlignment="Center">
                        <!-- Populated dynamically with rounded capsule bars in code-behind -->
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 3 Clean Summary KPI Cards -->
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{ThemeResource ShiftCardBgBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="12">
                    <StackPanel Spacing="2">
                        <TextBlock Text="TOTAL TIME" FontSize="10" FontWeight="Bold" Opacity="0.6" CharacterSpacing="50" />
                        <TextBlock x:Name="KpiTotalHours" Text="0.0 hrs" FontSize="20" FontWeight="Bold" Foreground="{ThemeResource ShiftFlowGreenBrush}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Background="{ThemeResource ShiftCardBgBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="12">
                    <StackPanel Spacing="2">
                        <TextBlock Text="SHIFTS" FontSize="10" FontWeight="Bold" Opacity="0.6" CharacterSpacing="50" />
                        <TextBlock x:Name="KpiCompletedCount" Text="0" FontSize="20" FontWeight="Bold" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Background="{ThemeResource ShiftCardBgBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="12">
                    <StackPanel Spacing="2">
                        <TextBlock Text="STREAK" FontSize="10" FontWeight="Bold" Opacity="0.6" CharacterSpacing="50" />
                        <TextBlock x:Name="KpiStreakDays" Text="0 days" FontSize="20" FontWeight="Bold" />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
